# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# Ignore virtual environments
.venv/
env/
venv/

# Ignore build and distribution folders
dist/
build/
*.egg-info/

# Ignore compiled executables
*.exe
*.dll
*.so
*.dylib

# Ignore large archives
*.zip
*.tar
*.gz
*.7z

# Ignore Spotify cache
.spotify_cache/
.cache/

# Ignore IDE/editor configs
.vscode/
.idea/
.env
